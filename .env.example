MONGO_URI=mongodb://127.0.0.1:27017/chat_app
PORT=5000
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / Socket.IO: để trống = cho phép mọi origin (tiện dev). Production: danh sách URL cách nhau bởi dấu phẩy
# Ví dụ: CORS_ORIGIN=https://myapp.com,https://www.myapp.com
CORS_ORIGIN=

# Giới hạn upload (MB), mặc định 25
UPLOAD_MAX_MB=25

# Tin cậy X-Forwarded-For (rate limit đúng IP client khi sau reverse proxy). Local: 0 hoặc false
TRUST_PROXY_HOPS=0
